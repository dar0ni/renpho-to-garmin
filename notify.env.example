# Kopieren nach notify.env und ausfuellen:  cp notify.env.example notify.env
# notify.env NICHT ins Git-Repo aufnehmen (enthaelt den Bot-Token).
# chmod 600 notify.env danach nicht vergessen.

# Bot-Token: in Telegram zu @BotFather -> /mybots -> Bot auswaehlen -> API Token
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ziel-Chat-ID: eigene Telegram-ID, z.B. via @userinfobot ermitteln (Nachricht
# schicken, antwortet sofort mit "Id: 123456789")
TELEGRAM_CHAT_ID=123456789
